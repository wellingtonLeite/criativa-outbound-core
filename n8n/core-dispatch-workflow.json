        [{ "node": "Loop Campanhas", "type": "main", "index": 0 }],
        [{ "node": "Montar E-mail", "type": "main", "index": 0 }]
      ]
    },
    "Montar E-mail": {
      "main": [[{ "node": "Tem Credencial OpenRouter?", "type": "main", "index": 0 }]]
    },
    "Tem Credencial OpenRouter?": {
      "main": [
        [{ "node": "Montar Prompt IA", "type": "main", "index": 0 }],
        [{ "node": "Enviar via Resend", "type": "main", "index": 0 }]
      ]
    },
    "Montar Prompt IA": {
      "main": [[{ "node": "Gerar E-mail com IA", "type": "main", "index": 0 }]]
    },
    "Gerar E-mail com IA": {
      "main": [[{ "node": "Aplicar E-mail da IA", "type": "main", "index": 0 }]]
    },
    "Aplicar E-mail da IA": {
