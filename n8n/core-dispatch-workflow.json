{
  "name": "CORE - Disparo Automático (Etapa 4)",
  "nodes": [
    {
      "id": "trigger_schedule",
      "name": "A cada 60 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -1400,
        300
      ],
      "notes": "Intervalo alto o suficiente para nunca sobrepor uma execução anterior (que pode levar 30+ min processando leads com espera de 2,5 min entre envios).",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 60
            }
          ]
        }
      }
    },
    {
      "id": "config",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1160,
        300
      ],
      "notes": "EDITE estes 4 valores antes de ativar o workflow.",
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "return [{\n  json: {\n    supabase_url: 'https://SEU-PROJECT-REF.supabase.co',\n    supabase_service_role_key: 'COLE_AQUI_A_SERVICE_ROLE_KEY',\n    resend_reply_to: ['anamartins@criativamarketing.com', 'wellington.leite@criativamarketing.com'],\n    resend_from: 'Nome da Empresa <onboarding@seudominio.com>',\n  }\n}];"
      }
    },
