      "id": "code_apply_ai_email",
      "name": "Aplicar E-mail da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        100
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const original = $('Montar Prompt IA').item.json;\nconst response = $input.first().json;\nlet subject = original.fallback_subject;\nlet html = original.fallback_html;\ntry {\n  const out = response.output ?? response;\n  if (out && typeof out === 'object' && out.subject && out.html) {\n    subject = out.subject;\n    html = out.html;\n  } else if (typeof response.text === 'string') {\n    const cleaned = response.text.trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\n    const parsed = JSON.parse(cleaned);\n    if (parsed.subject && parsed.html) { subject = parsed.subject; html = parsed.html; }\n  }\n} catch (e) {\n  // Resposta da IA inválida — mantém o fallback do template fixo\n}\nreturn [{ json: { ...original, email_subject: subject, email_html: html } }];"
      }
    },
