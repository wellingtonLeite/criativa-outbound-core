{
  "name": "CORE - Disparo Automático (Etapa 4)",
  "nodes": [
    {
      "id": "trigger_schedule",
      "name": "A cada 15 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-1400, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      }
    },
    {
      "id": "config",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-1160, 300],
      "notes": "EDITE estes 4 valores antes de ativar o workflow.",
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "return [{\n  json: {\n    supabase_url: 'https://SEU-PROJECT-REF.supabase.co',\n    supabase_service_role_key: 'COLE_AQUI_A_SERVICE_ROLE_KEY',\n    resend_from: 'Nome da Empresa <onboarding@seudominio.com>',\n  }\n}];"
      }
    },
    {
      "id": "http_get_campaigns",
      "name": "Buscar Campanhas Ativas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-920, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.supabase_url }}/rest/v1/campaigns?status=eq.active&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $json.supabase_service_role_key }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code_normalize_campaigns",
      "name": "Normalizar Campanhas",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-680, 300],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "return $input.all();"
      }
    },
    {
      "id": "loop_campaigns",
      "name": "Loop Campanhas",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-440, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "no_op_end",
      "name": "Fim",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [-200, 140],
      "parameters": {}
    },
    {
      "id": "http_get_sent_today",
      "name": "Quota Enviada Hoje",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-200, 460],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/rpc/get_emails_sent_today_for_campaign",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_campaign_id: $json.id } }}",
        "options": {}
      }
    },
    {
      "id": "code_remaining_quota",
      "name": "Calcular Quota Restante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 460],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const campaign = $('Loop Campanhas').item.json;\nconst raw = $input.first().json;\nconst sentToday = typeof raw === 'number' ? raw : (raw.data ?? 0);\nconst remaining = Math.max(0, (campaign.daily_send_limit || 0) - sentToday);\nreturn [{ json: { ...campaign, remaining_quota: remaining } }];"
      }
    },
    {
      "id": "if_has_quota",
      "name": "Tem Quota?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [280, 460],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond_quota",
              "leftValue": "={{ $json.remaining_quota }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "http_get_resend_cred",
      "name": "Buscar Credencial Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [560, 400],
      "alwaysOutputData": true,
      "notes": "alwaysOutputData=true garante 1 item mesmo se a busca não achar nenhuma credencial (array vazio), para o node seguinte sempre rodar.",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/credentials?user_id=eq.{{ $json.user_id }}&service_name=eq.resend&is_active=eq.true&order=created_at.desc&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code_extract_cred",
      "name": "Extrair Credencial",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, 400],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const campaign = $('Tem Quota?').item.json;\nconst raw = $input.first().json;\nconst arr = Array.isArray(raw) ? raw : [raw];\nreturn [{ json: { ...campaign, resend_api_key: arr[0]?.api_key || null } }];"
      }
    },
    {
      "id": "http_get_openrouter_cred",
      "name": "Buscar Credencial OpenRouter",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [800, 560],
      "alwaysOutputData": true,
      "notes": "Opcional — se o dono da campanha não tiver OpenRouter configurado, o e-mail usa só o template fixo. alwaysOutputData=true garante 1 item mesmo sem credencial encontrada.",
      "parameters": {
        "method": "GET",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/credentials?user_id=eq.{{ $json.user_id }}&service_name=eq.openrouter&is_active=eq.true&order=created_at.desc&limit=1",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code_extract_openrouter_cred",
      "name": "Extrair Credencial OpenRouter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 560],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const campaign = $('Extrair Credencial').item.json;\nconst raw = $input.first().json;\nconst arr = Array.isArray(raw) ? raw : [raw];\nreturn [{ json: { ...campaign, openrouter_api_key: arr[0]?.api_key || null } }];"
      }
    },
    {
      "id": "if_has_resend",
      "name": "Tem Credencial Resend?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1040, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond_resend",
              "leftValue": "={{ $json.resend_api_key }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "http_get_send_queue",
      "name": "Buscar Fila de Envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1320, 340],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/rpc/get_send_queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { p_campaign_id: $json.id, p_limit: $json.remaining_quota } }}",
        "options": {}
      }
    },
    {
      "id": "code_normalize_queue",
      "name": "Normalizar Fila",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 340],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const campaign = $('Extrair Credencial OpenRouter').item.json;\nreturn $input.all().map(item => ({ json: { ...item.json, resend_api_key: campaign.resend_api_key, openrouter_api_key: campaign.openrouter_api_key } }));"
      }
    },
    {
      "id": "loop_leads",
      "name": "Loop Leads",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [1800, 340],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "code_build_email",
      "name": "Montar E-mail",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2040, 200],
      "notes": "Monta o e-mail base (fallback) por substituição literal. Se houver credencial OpenRouter, os nodes seguintes tentam gerar uma versão personalizada por IA e sobrescrevem email_subject/email_html.",
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const cfg = $('Configuração').first().json;\nconst row = $input.first().json;\nconst fill = (tpl) => (tpl || '')\n  .replaceAll('{{first_name}}', row.lead_first_name || '')\n  .replaceAll('{{company_name}}', row.lead_company || '');\nconst fallbackSubject = fill(row.subject);\nconst fallbackHtml = fill(row.body_html);\nreturn [{ json: {\n  ...row,\n  fallback_subject: fallbackSubject,\n  fallback_html: fallbackHtml,\n  email_subject: fallbackSubject,\n  email_html: fallbackHtml,\n  resend_from: cfg.resend_from,\n} }];"
      }
    },
    {
      "id": "if_has_openrouter",
      "name": "Tem Credencial OpenRouter?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [2280, 200],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "combinator": "and",
          "conditions": [
            {
              "id": "cond_openrouter",
              "leftValue": "={{ $json.openrouter_api_key }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty", "singleValue": true }
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "code_build_prompt",
      "name": "Montar Prompt IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2520, 100],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const row = $input.first().json;\nconst company = row.company_info || {};\nconst person = row.person_info || {};\nconst details = [\n  company.industry ? `Indústria: ${company.industry}` : null,\n  (company.short_description || company.description) ? `Descrição da empresa: ${company.short_description || company.description}` : null,\n  Array.isArray(company.keywords) && company.keywords.length ? `Palavras-chave: ${company.keywords.slice(0, 8).join(', ')}` : null,\n  company.estimated_num_employees ? `Porte: ${company.estimated_num_employees} funcionários` : null,\n  person.title ? `Cargo do contato: ${person.title}` : null,\n  person.seniority ? `Senioridade: ${person.seniority}` : null,\n].filter(Boolean).join('\\n');\n\nconst prompt = `Você é um redator de cold email B2B em português do Brasil. Reescreva o e-mail abaixo para ficar mais pessoal e relevante para esta empresa específica, mantendo a mesma intenção/oferta e um tamanho aproximado. Não invente dados que não foram fornecidos.\n\nNome do lead: ${row.lead_first_name || ''}\nEmpresa: ${row.lead_company || ''}\n${details || 'Nenhum dado adicional disponível sobre a empresa.'}\n\nE-mail base:\nAssunto: ${row.fallback_subject}\nCorpo (HTML): ${row.fallback_html}\n\nResponda APENAS com um JSON válido, sem markdown, sem texto antes ou depois, no formato exato:\n{\"subject\": \"...\", \"html\": \"...\"}`;\n\nreturn [{ json: { ...row, ai_prompt: prompt } }];"
      }
    },
    {
      "id": "http_call_openrouter",
      "name": "Gerar E-mail com IA",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2760, 100],
      "notes": "Modelo gratuito da OpenRouter. Troque em model se este ficar indisponível — veja https://openrouter.ai/models?max_price=0",
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.openrouter_api_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: 'google/gemma-4-31b-it:free', messages: [ { role: 'user', content: $json.ai_prompt } ] } }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "code_apply_ai_email",
      "name": "Aplicar E-mail da IA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3000, 100],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const original = $('Montar Prompt IA').item.json;\nconst response = $input.first().json;\nlet subject = original.fallback_subject;\nlet html = original.fallback_html;\ntry {\n  const content = response.choices?.[0]?.message?.content;\n  if (content) {\n    const cleaned = content.trim().replace(/^```json/i, '').replace(/^```/, '').replace(/```$/, '').trim();\n    const parsed = JSON.parse(cleaned);\n    if (parsed.subject && parsed.html) {\n      subject = parsed.subject;\n      html = parsed.html;\n    }\n  }\n} catch (e) {\n  // Resposta da IA inválida — mantém o fallback do template fixo\n}\nreturn [{ json: { ...original, email_subject: subject, email_html: html } }];"
      }
    },
    {
      "id": "http_send_resend",
      "name": "Enviar via Resend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3240, 200],
      "parameters": {
        "method": "POST",
        "url": "https://api.resend.com/emails",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $json.resend_api_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { from: $json.resend_from, to: [$json.lead_email], subject: $json.email_subject, html: $json.email_html } }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "http_log_outreach",
      "name": "Registrar Envio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3480, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/outreach_logs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { lead_id: $('Montar E-mail').item.json.lead_id, template_id: $('Montar E-mail').item.json.template_id, event_type: 'sent' } }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "http_update_lead",
      "name": "Atualizar Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3720, 200],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Configuração').first().json.supabase_url }}/rest/v1/leads?id=eq.{{ $('Montar E-mail').item.json.lead_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $('Configuração').first().json.supabase_service_role_key }}" },
            { "name": "Authorization", "value": "=Bearer {{ $('Configuração').first().json.supabase_service_role_key }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { current_step: $('Montar E-mail').item.json.next_step, last_contacted_at: new Date().toISOString(), funnel_status: 'in_sequence' } }}",
        "options": {}
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "A cada 15 minutos": {
      "main": [[{ "node": "Configuração", "type": "main", "index": 0 }]]
    },
    "Configuração": {
      "main": [[{ "node": "Buscar Campanhas Ativas", "type": "main", "index": 0 }]]
    },
    "Buscar Campanhas Ativas": {
      "main": [[{ "node": "Normalizar Campanhas", "type": "main", "index": 0 }]]
    },
    "Normalizar Campanhas": {
      "main": [[{ "node": "Loop Campanhas", "type": "main", "index": 0 }]]
    },
    "Loop Campanhas": {
      "main": [
        [{ "node": "Fim", "type": "main", "index": 0 }],
        [{ "node": "Quota Enviada Hoje", "type": "main", "index": 0 }]
      ]
    },
    "Quota Enviada Hoje": {
      "main": [[{ "node": "Calcular Quota Restante", "type": "main", "index": 0 }]]
    },
    "Calcular Quota Restante": {
      "main": [[{ "node": "Tem Quota?", "type": "main", "index": 0 }]]
    },
    "Tem Quota?": {
      "main": [
        [{ "node": "Buscar Credencial Resend", "type": "main", "index": 0 }],
        [{ "node": "Loop Campanhas", "type": "main", "index": 0 }]
      ]
    },
    "Buscar Credencial Resend": {
      "main": [[{ "node": "Extrair Credencial", "type": "main", "index": 0 }]]
    },
    "Extrair Credencial": {
